rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // FONCTIONS GÉNÉRALES
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ["admin", "superadmin"];
    }


    // =========================================================
    // USERS
    // =========================================================

    // Ensemble des champs autorisés dans un document user.
    function allowedUserKeys() {
      return [
        "uid",
        "email",
        "role",

        "plan",
        "planType",
        "accountStatus",
        "subscriptionStatus",

        "entitlement",
        "entitlementStatus",
        "paymentStatus",

        "monthlyQuota",
        "monthlyUsed",
        "isTestAccount",

        "businessProfile",
        "displayName",

        "createdAt",
        "updatedAt"
      ];
    }

    // Champs autorisés lors de la création CLIENT.
    // Aucun plan, entitlement, statut Stripe ou rôle admin
    // ne peut être créé depuis le navigateur.
    function allowedUserCreateKeys() {
      return [
        "uid",
        "email",
        "role",
        "accountStatus",
        "createdAt",
        "updatedAt"
      ];
    }

    // Champs qu'un utilisateur peut modifier lui-même.
    // Aucun rôle, plan, entitlement ou statut de paiement ici.
    function allowedUserUpdateKeys() {
      return [
        "businessProfile",
        "displayName",
        "updatedAt"
      ];
    }


    // =========================================================
    // DOSSIERS / REQUESTS
    // =========================================================

    function allowedRequestKeys() {
      return [
        "ref",
        "label",

        // Ancienne compatibilité montant / facture
        "amountTTC",
        "amountDue",
        "invoiceRef",
        "invoiceNumber",
        "issuedDate",
        "invoiceIssuedDate",
        "dueDate",
        "invoiceDueDate",

        "contractBasis",

        // Factures détaillées
        "invoices",
        "lateRatePercent",

        // Paiements reçus du débiteur
        "payments",
        "totalPayments",
        "principalBalance",

        // Créancier
        "creditorName",
        "creditorEmail",
        "creditorAddress",
        "creditorZip",
        "creditorCity",

        // Débiteur - ancienne compatibilité
        "debiteurType",
        "debiteurName",
        "debiteurEmail",
        "debiteurPhone",
        "debiteurAddress",
        "debiteurZip",
        "debiteurCity",

        // Débiteur
        "debtorName",
        "debtorEmail",
        "debtorPhone",
        "debtorAddress",
        "debtorZip",
        "debtorCity",

        // Dossier
        "homeName",
        "objectLabel",
        "dossierSummary",

        // Workflow
        "status",
        "statusLabel",
        "step",
        "currentStep",
        "nextAction",
        "nextActionAt",

        // Étapes envoyées
        "relance1SentAt",
        "relance2SentAt",
        "relance3SentAt",
        "miseEnDemeureSentAt",
        "injunctionPreparedAt",

        // Injonction
        "injunctionPublished",
        "postOrderChoice",

        // Droit d'utilisation Axe Flow
        "entitlementId",
        "entitlementUsed",
        "entitlementPlan",
        "offerType",
        "clientUid",

        // Cycle de vie
        "lifecycleStatus",
        "paymentStatus",

        // Échanges / fichiers
        "clientHasNewFiles",
        "clientLastUploadAt",
        "clientFilesUpdatedAt",
        "clientStatus",
        "clientActionRequired",
        "lastClientProofAt",
        "lastPublishedEventAt",
        "proofsCompletionStatus",

        // Administration dossier
        "priority",
        "closedAt",
        "archivedAt",
        "closureReason",
        "closureComment",

        "createdAt",
        "updatedAt"
      ];
    }


    function allowedRequestUpdateKeys() {
      return [

        // Créancier
        "creditorName",
        "creditorEmail",
        "creditorAddress",
        "creditorZip",
        "creditorCity",

        // Débiteur
        "debtorName",
        "debtorEmail",
        "debtorAddress",
        "debtorZip",
        "debtorCity",

        // Compatibilité anciens champs débiteur
        "debiteurName",
        "debiteurEmail",
        "debiteurAddress",
        "debiteurZip",
        "debiteurCity",
        "debiteurType",

        // Factures
        "amountTTC",
        "amountDue",
        "invoiceRef",
        "invoiceNumber",
        "issuedDate",
        "invoiceIssuedDate",
        "dueDate",
        "invoiceDueDate",
        "contractBasis",
        "invoices",
        "lateRatePercent",

        // Paiements reçus du débiteur
        "payments",
        "totalPayments",
        "principalBalance",

        // Workflow
        "step",
        "currentStep",
        "status",
        "statusLabel",
        "lifecycleStatus",
        "nextAction",
        "nextActionAt",

        // Étapes
        "relance1SentAt",
        "relance2SentAt",
        "relance3SentAt",
        "miseEnDemeureSentAt",
        "injunctionPreparedAt",

        // Injonction
        "injunctionPublished",
        "postOrderChoice",

        // Clôture
        "closedAt",
        "closureReason",
        "closureComment",

        "updatedAt"
      ];
    }


    // =========================================================
    // HISTORIQUE / EVENTS
    // =========================================================

    function allowedEventKeys() {
      return [
        "title",
        "description",
        "action",
        "type",

        // Événement paiement débiteur
        "amount",
        "effectiveDate",
        "method",
        "reference",
        "balanceAfter",

        "createdAt",
        "updatedAt"
      ];
    }


    // =========================================================
    // FICHIERS
    // =========================================================

    function allowedFileKeys() {
      return [
        "name",
        "filename",
        "url",
        "path",
        "type",
        "mimeType",
        "size",
        "uploadedAt",
        "createdAt",
        "updatedAt"
      ];
    }


    // =========================================================
    // ENTITLEMENTS AXE FLOW
    // =========================================================

    function allowedEntitlementKeys() {
      return [
        "type",
        "status",
        "grantedCaseCount",
        "usedCaseCount",

        "validFrom",
        "validUntil",

        "sourcePaymentId",
        "source",

        "stripeSessionId",
        "stripeSubscriptionId",
        "stripeCustomerId",

        "createdAt",
        "updatedAt"
      ];
    }


    // =========================================================
    // PAIEMENTS STRIPE AXE FLOW
    // =========================================================

    function allowedPaymentKeys() {
      return [
        "type",
        "status",
        "amount",
        "currency",
        "provider",

        "stripeSessionId",
        "stripePaymentIntentId",
        "stripeSubscriptionId",
        "stripeCustomerId",
        "paymentLinkId",

        "createdAt",
        "updatedAt"
      ];
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();


      // ---------------------------------------------------------
      // Création du profil utilisateur
      //
      // La connexion Axe Flow crée uniquement :
      // uid / email / role=client / accountStatus=active
      // createdAt / updatedAt
      // ---------------------------------------------------------

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(allowedUserCreateKeys())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "client"
        && request.resource.data.accountStatus == "active";


      // ---------------------------------------------------------
      // Modification du profil
      //
      // Le client peut uniquement modifier :
      // businessProfile / displayName / updatedAt
      //
      // Il ne peut PAS modifier :
      // role / plan / entitlement / paymentStatus / quotas etc.
      // ---------------------------------------------------------

      allow update: if (
          isOwner(userId)

          && request.resource.data.keys().hasOnly(allowedUserKeys())

          && request.resource.data.uid == resource.data.uid

          && request.resource.data.email == resource.data.email

          && request.resource.data
            .diff(resource.data)
            .changedKeys()
            .hasOnly(allowedUserUpdateKeys())
        )
        || isAdmin();


      allow delete: if isAdmin();


      // =========================================================
      // DOSSIERS
      // =========================================================

      match /requests/{requestId} {

        allow read: if isOwner(userId) || isAdmin();


        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(allowedRequestKeys());


        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(allowedRequestKeys())
          && request.resource.data
            .diff(resource.data)
            .changedKeys()
            .hasOnly(allowedRequestUpdateKeys());


        allow delete: if isOwner(userId) || isAdmin();


        // =======================================================
        // HISTORIQUE DU DOSSIER
        // =======================================================

        match /events/{eventId} {

          allow read: if isOwner(userId) || isAdmin();


          allow create: if isOwner(userId)
            && request.resource.data.keys().hasOnly(allowedEventKeys());


          // L'historique existant n'est pas modifiable par le client.
          allow update: if isAdmin();


          // Les événements ordinaires peuvent être supprimés
          // par "Réinitialiser le suivi".
          //
          // Un paiement reçu du débiteur est en revanche
          // protégé et ne peut pas être supprimé côté client.
          allow delete: if isAdmin()
            || (
              isOwner(userId)
              && resource.data.type != "payment"
              && resource.data.action != "payment_received"
            );


          // -----------------------------------------------------
          // Justificatifs associés à un événement
          // -----------------------------------------------------

          match /proofs/{proofId} {

            allow read: if isOwner(userId) || isAdmin();

            allow create, update, delete:
              if isOwner(userId) || isAdmin();
          }
        }


        // =======================================================
        // DOCUMENTS DU DOSSIER
        // =======================================================

        match /documents/{documentId} {

          allow read, create, update, delete:
            if isOwner(userId) || isAdmin();
        }


        // =======================================================
        // FICHIERS DU DOSSIER
        // =======================================================

        match /files/{fileId} {

          allow read, create, update, delete:
            if isOwner(userId) || isAdmin();
        }


        // =======================================================
        // MESSAGES DU DOSSIER
        // =======================================================

        match /messages/{messageId} {

          allow read, create, update, delete:
            if isOwner(userId) || isAdmin();
        }

      } // FIN requests


      // =========================================================
      // ENTITLEMENTS AXE FLOW
      //
      // Lecture client autorisée.
      // Écriture navigateur client interdite.
      //
      // Les Cloud Functions utilisant Firebase Admin SDK
      // ne sont pas bloquées par les règles Firestore.
      // =========================================================

      match /entitlements/{entitlementId} {

        allow read: if isOwner(userId) || isAdmin();

        allow create, update, delete: if isAdmin();
      }


      // =========================================================
      // PAIEMENTS STRIPE AXE FLOW
      //
      // Paiements du CLIENT envers Axe Flow.
      // À ne pas confondre avec les règlements des débiteurs
      // enregistrés dans les dossiers.
      // =========================================================

      match /payments/{paymentId} {

        allow read: if isOwner(userId) || isAdmin();

        allow create, update, delete: if isAdmin();
      }

    } // FIN users/{userId}


    // =========================================================
    // ESPACE ADMIN
    // =========================================================

    match /admin/{document=**} {

      allow read, write: if isAdmin();
    }

  } // FIN database
} // FIN firestore
